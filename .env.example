# Copy to .env and fill in. Never commit .env.
GNANI_API_KEY=

# LLM: free by default via Groq (https://console.groq.com/keys - no card needed)
LLM_PROVIDER=groq
GROQ_API_KEY=

# Other options (set LLM_PROVIDER and the matching key):
#   gemini     -> GEMINI_API_KEY      (https://aistudio.google.com/apikey, free tier, low daily limit)
#   openrouter -> OPENROUTER_API_KEY  (free ":free" models)
#   ollama     -> no key, runs a local model (needs a decent laptop)
#   anthropic  -> ANTHROPIC_API_KEY   (paid; claude-opus-5-5)
# LLM_MODEL=openai/gpt-oss-120b   # override the provider's default model
# LLM_BASE_URL=                       # any other OpenAI-compatible endpoint

# Optional tuning
# TTS_VOICE=Shivani       # any Timbre v3.0 voice
# TTS_SPEED=1.0           # 0.8 | 1.0 | 1.2
# STT_FORMAT=transcribe   # transcribe | codemix | verbatim
# VAD_THRESHOLD=0.5       # raise for noisier streets
# VAD_MIN_SILENCE_MS=600  # end-of-utterance silence; lower = snappier, higher = fewer split sentences
# VAD_MIN_SPEECH_MS=120
# VAD_MIN_SEGMENT_MS=120
# VAD_MAX_SPEECH_S=25

# Optional BACKUP providers: any of these keys, if set, is appended to the fallback chain
# (used only when every model of LLM_PROVIDER is rate-limited / out of daily budget).
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
